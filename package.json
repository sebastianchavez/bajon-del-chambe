{
  "name": "bajon-del-chambe",
  "version": "1.0.0",
  "description": "Web de El Bajón del Chambe — comida rápida. Landing page, catálogo y contacto.",
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tailwindcss -i ./src/css/main.css -o ./dist/styles.css --minify",
