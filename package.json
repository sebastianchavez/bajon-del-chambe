  "keywords": [
    "fast-food",
    "tailwind",
    "restaurante"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
